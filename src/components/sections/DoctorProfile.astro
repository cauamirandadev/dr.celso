---
import CTAButton from '../ui/CTAButton.astro';

const credentials = [
  { label: 'CRM', value: 'CRM-MG 33.379' },
  { label: 'Formação', value: '[PENDENTE — graduação e instituição]' },
  { label: 'Residência', value: '[PENDENTE — residência em ortopedia e traumatologia]' },
  { label: 'Sociedades', value: 'SBOT — Sociedade Brasileira de Ortopedia e Traumatologia' },
  { label: 'Experiência', value: 'Mais de 20 anos de prática clínica e cirúrgica em Uberaba, MG' },
];
---

<!-- Seção principal: banner horizontal integrado -->
<section
  class="relative bg-primary overflow-hidden"
  aria-label="Perfil do Dr. Celso Pintinha"
>
  <!-- Banner full background -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/assets/doctor/banner-dr-celso-perfil.jpeg"
      alt=""
      class="w-full h-full object-cover object-[30%_15%]"
      loading="lazy"
    />
    <!-- Mobile: gradiente vertical mais escuro / Desktop: gradiente horizontal -->
    <div class="absolute inset-0 bg-gradient-to-b from-primary/60 via-primary/80 to-primary/95 md:bg-gradient-to-r md:from-transparent md:via-primary/40 md:to-primary/95"></div>
  </div>

  <!-- Conteúdo (texto à direita) -->
  <div class="relative z-10 container py-16 md:py-24 flex items-end md:items-center min-h-[500px] md:min-h-[600px]">
    <div class="ml-auto max-w-md md:max-w-lg flex flex-col gap-6">

      <p class="text-accent text-xs font-display font-semibold uppercase tracking-[0.2em]">Sobre</p>

      <h1 class="font-display font-bold text-display-xl text-cream heading-display">
        Dr. Celso Pintinha
      </h1>

      <p class="text-cream/70 text-sm">Ortopedista e traumatologista em Uberaba, MG.</p>

      <div class="flex flex-col gap-4 text-cream/80 text-base leading-relaxed">
        <p>
          [PENDENTE — biografia profissional curta a confirmar com o cliente]
        </p>
        <p>
          Atende atualmente no <strong class="font-medium text-cream">Hospital São Marcos</strong>
          e no <strong class="font-medium text-cream">Instituto Sem Dor</strong>.
          Agendamentos pelo WhatsApp da secretária.
        </p>
        <p>
          [PENDENTE — parágrafo adicional de trajetória ou especialização]
        </p>
      </div>

      <CTAButton href="/agendar" label="Agendar consulta" variant="primary" />

    </div>
  </div>
</section>

<!-- Credenciais — seção separada abaixo do banner -->
<section class="bg-primary-dark py-12 md:py-16" aria-label="Formação e Credenciais">
  <div class="container flex flex-col gap-8">
    <h2 class="font-display text-display-md text-cream heading-display">
      Formação e Credenciais
    </h2>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-6">
      {credentials.map(({ label, value }) => (
        <div class="flex flex-col gap-1">
          <dt class="text-xs font-semibold text-accent uppercase tracking-widest">{label}</dt>
          <dd class="text-sm text-cream/70 leading-relaxed">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- Fotos de evidência: SBOT + Cirurgia -->
<section class="bg-primary py-12 md:py-16" aria-label="Registros profissionais">
  <div class="container">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">

      <figure class="flex flex-col gap-2">
        <div class="relative rounded-card overflow-hidden aspect-[3/4]">
          <img
            src="/assets/doctor/dr-celso-sbot.webp"
            alt="Dr. Celso Pintinha no 57º Congresso Brasileiro de Ortopedia e Traumatologia"
            class="absolute inset-0 w-full h-full object-cover object-top"
            loading="lazy"
            width="640"
            height="853"
          />
        </div>
        <figcaption class="text-xs text-cream/50 text-center px-2">
          57º Congresso SBOT — Salvador, 2025
        </figcaption>
      </figure>

      <figure class="flex flex-col gap-2">
        <div class="relative rounded-card overflow-hidden aspect-[3/4]">
          <img
            src="/assets/doctor/dr-celso-cirurgia.webp"
            alt="Dr. Celso Pintinha em procedimento cirúrgico"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
            width="640"
            height="480"
          />
        </div>
        <figcaption class="text-xs text-cream/50 text-center px-2">
          Procedimento cirúrgico em ambiente hospitalar
        </figcaption>
      </figure>

    </div>
  </div>
</section>
