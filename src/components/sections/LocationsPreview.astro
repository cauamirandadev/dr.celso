---
import SectionTitle from '../ui/SectionTitle.astro';
import LocationCard from '../ui/LocationCard.astro';
import CTAButton from '../ui/CTAButton.astro';
import FadeIn from '../ui/FadeIn.astro';

const locations = [
  {
    name: 'Hospital São Marcos',
    address: 'Av. Santos Dumont, 2191 - Vila Santa Maria, Uberaba - MG, 38050-400',
    schedule: ['[PENDENTE — dias e horários de atendimento]'],
    phone: '[PENDENTE — telefone fixo]',
    mapsUrl: 'https://maps.google.com/?q=Av.+Santos+Dumont,+2191,+Vila+Santa+Maria,+Uberaba,+MG',
    imageUrl: '/assets/locations/hospital-sao-marcos.jpeg',
    whatsappPhone: '5534992206100',
  },
  {
    name: 'Instituto Sem Dor',
    address: 'Av. Santos Dumont, 2335 - Vila Santa Maria, Uberaba - MG, 38050-400',
    schedule: ['[PENDENTE — dias e horários de atendimento]'],
    phone: '[PENDENTE — telefone fixo]',
    mapsUrl: 'https://maps.google.com/?q=Av.+Santos+Dumont,+2335,+Vila+Santa+Maria,+Uberaba,+MG',
    imageUrl: '/assets/locations/instituto-sem-dor.webp',
    whatsappPhone: '5534992206100',
  },
];
---

<section class="section bg-primary-light" aria-label="Locais de atendimento">
  <div class="container flex flex-col gap-10 md:gap-12">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <SectionTitle
        title="Onde Atendemos"
        subtitle="Dois locais em Uberaba. Mesmo agendamento pelo WhatsApp."
      />
      <CTAButton href="/agendar" label="Agendar consulta" variant="primary" />
    </div>

    <FadeIn class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {locations.map((loc) => (
        <LocationCard
          name={loc.name}
          address={loc.address}
          schedule={loc.schedule}
          phone={loc.phone}
          mapsUrl={loc.mapsUrl}
          imageUrl={loc.imageUrl}
          whatsappPhone={loc.whatsappPhone}
        />
      ))}
    </FadeIn>

  </div>
</section>
