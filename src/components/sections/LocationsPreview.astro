---
import SectionTitle from '../ui/SectionTitle.astro';
import LocationCard from '../ui/LocationCard.astro';
import CTAButton from '../ui/CTAButton.astro';
import FadeIn from '../ui/FadeIn.astro';

const locations = [
  {
    name: 'Ambulatório do Hospital São Marcos',
    address: 'Rua Acre, 468 · Santa Maria · Uberaba - MG',
    schedule: [
      'Segundas, quartas e sextas-feiras',
      'Manhã e tarde',
    ],
    phone: '(34) 2103-6161',
    mapsUrl: 'https://maps.google.com/?q=Rua+Acre,+468,+Santa+Maria,+Uberaba,+MG',
    imageUrl: '/assets/doctor/ambulatorio-sao-marcos.jpeg',
    whatsappPhone: '5534992206100',
  },
  {
    name: 'Instituto Sem Dor',
    address: 'Av. Santos Dumont, 2335 · Santa Maria · Uberaba - MG',
    schedule: [
      'Terças e quintas-feiras',
      'À tarde',
    ],
    phone: '(34) 3313-6900',
    mapsUrl: 'https://maps.google.com/?q=Av.+Santos+Dumont,+2335,+Santa+Maria,+Uberaba,+MG',
    imageUrl: '/assets/locations/instituto-sem-dor.webp',
    whatsappPhone: '5534992206100',
  },
];
---

<section class="section bg-light-bg [&_.text-cream]:text-on-light [&_.text-cream-muted]:text-on-light-muted" aria-label="Locais de atendimento">
  <div class="container flex flex-col gap-10 md:gap-12">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <SectionTitle
        title="Onde Atendemos"
        subtitle="Dois locais em Uberaba. Mesmo agendamento pelo WhatsApp."
        theme="light"
      />
      <CTAButton href="/agendar" label="Agendar consulta" variant="primary" />
    </div>

    <FadeIn class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {locations.map((loc) => (
        <LocationCard
          name={loc.name}
          address={loc.address}
          schedule={loc.schedule}
          phone={loc.phone}
          mapsUrl={loc.mapsUrl}
          imageUrl={loc.imageUrl}
          whatsappPhone={loc.whatsappPhone}
          theme="light"
        />
      ))}
    </FadeIn>

  </div>
</section>
