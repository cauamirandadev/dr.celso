---
const year = new Date().getFullYear();
---

<footer class="bg-primary-dark" role="contentinfo">
  <div class="container py-12 md:py-16">

    <!-- Logo centralizada -->
    <div class="flex flex-col items-center gap-3 mb-10 md:mb-12">
      <img
        src="/assets/doctor/logo-sem-fundo.png"
        alt="Dr. Celso Pintinha"
        class="h-16 w-auto"
        loading="lazy"
      />
      <p class="text-cream-muted text-sm text-center font-body">
        Dr. Celso Pintinha · CRM-MG [PENDENTE] · Ortopedia e Traumatologia
      </p>
    </div>

    <!-- Locais de atendimento -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 md:gap-12 max-w-2xl mx-auto mb-10 md:mb-12">

      <address class="not-italic flex flex-col gap-2">
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-4 h-4 text-accent flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <p class="text-sm font-semibold text-cream">Ambulatório do Hospital São Marcos</p>
        </div>
        <p class="text-sm text-cream-muted leading-relaxed pl-6">Rua Acre, 468 · Santa Maria · Uberaba - MG</p>
        <p class="text-sm text-cream-muted pl-6">Seg, qua e sex · manhã e tarde</p>
        <p class="text-sm text-cream-muted pl-6">
          <a href="tel:553421036161" class="hover:text-cream transition-colors">(34) 2103-6161</a>
        </p>
      </address>

      <address class="not-italic flex flex-col gap-2">
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-4 h-4 text-accent flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <p class="text-sm font-semibold text-cream">Instituto Sem Dor</p>
        </div>
        <p class="text-sm text-cream-muted leading-relaxed pl-6">Av. Santos Dumont, 2335 · Santa Maria · Uberaba - MG</p>
        <p class="text-sm text-cream-muted pl-6">Ter e qui · à tarde</p>
        <p class="text-sm text-cream-muted pl-6">
          <a href="tel:553433136900" class="hover:text-cream transition-colors">(34) 3313-6900</a>
        </p>
      </address>

    </div>

    <!-- E-mail -->
    <div class="text-center mb-10 md:mb-12">
      <p class="text-sm text-cream-muted">
        <a href="mailto:celsopintinha@gmail.com" class="hover:text-cream transition-colors">celsopintinha@gmail.com</a>
      </p>
    </div>

    <!-- Copyright -->
    <div class="border-t border-border pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-cream-muted/60">
        © {year} Dr. Celso Pintinha. Todos os direitos reservados.
      </p>
      <nav aria-label="Links do rodapé" class="flex gap-6">
        <a
          href="/privacidade"
          class="text-xs text-cream-muted/60 hover:text-cream transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 rounded"
        >
          Política de Privacidade
        </a>
        <a
          href="https://portal.cfm.org.br"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-cream-muted/60 hover:text-cream transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 rounded"
        >
          CFM
          <span class="sr-only">(abre em nova aba)</span>
        </a>
      </nav>
    </div>

  </div>
</footer>
