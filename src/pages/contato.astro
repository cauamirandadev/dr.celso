---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationCard from '../components/ui/LocationCard.astro';
import MapEmbed from '../components/sections/MapEmbed.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import CTAButton from '../components/ui/CTAButton.astro';

const locations = [
  {
    name: 'Hospital São Marcos',
    address: 'Av. Santos Dumont, 2191 - Vila Santa Maria, Uberaba - MG, 38050-400',
    schedule: ['[PENDENTE — dias e horários de atendimento]'],
    phone: '[PENDENTE — telefone fixo]',
    mapsUrl: 'https://maps.google.com/?q=Av.+Santos+Dumont,+2191,+Vila+Santa+Maria,+Uberaba,+MG',
    mapsEmbedSrc: 'https://maps.google.com/maps?q=Av.+Santos+Dumont,+2191,+Uberaba,+MG&output=embed',
    imageUrl: '/assets/locations/hospital-sao-marcos.jpeg',
    whatsappPhone: '5534992206100',
  },
  {
    name: 'Instituto Sem Dor',
    address: 'Av. Santos Dumont, 2335 - Vila Santa Maria, Uberaba - MG, 38050-400',
    schedule: ['[PENDENTE — dias e horários de atendimento]'],
    phone: '[PENDENTE — telefone fixo]',
    mapsUrl: 'https://maps.google.com/?q=Av.+Santos+Dumont,+2335,+Vila+Santa+Maria,+Uberaba,+MG',
    mapsEmbedSrc: 'https://maps.google.com/maps?q=Av.+Santos+Dumont,+2335,+Uberaba,+MG&output=embed',
    imageUrl: '/assets/locations/instituto-sem-dor.webp',
    whatsappPhone: '5534992206100',
  },
];
---

<BaseLayout
  title="Contato e Localização — Dr. Celso Pintinha"
  description="Endereços, telefones e como chegar. Dr. Celso Pintinha atende no Hospital São Marcos e no Instituto Sem Dor, em Uberaba, MG."
>

  <!-- Cabeçalho da página -->
  <section class="py-12 md:py-16 bg-primary-light border-b border-border" aria-labelledby="page-heading">
    <div class="container">
      <h1
        id="page-heading"
        class="font-display text-display-lg text-cream heading-display"
      >
        Contato e Localização
      </h1>
      <p class="text-cream-muted mt-3 max-w-prose">
        Dois locais de atendimento em Uberaba. Agendamento pelo WhatsApp ou Doctoralia.
      </p>
    </div>
  </section>

  <!-- Endereços e mapas — cream -->
  <section class="section bg-light-bg [&_.text-cream]:text-on-light [&_.text-cream-muted]:text-on-light-muted" aria-label="Endereços dos locais de atendimento">
    <div class="container flex flex-col gap-12 md:gap-16">

      {locations.map((loc) => (
        <div class="flex flex-col gap-6">
          <LocationCard
            name={loc.name}
            address={loc.address}
            schedule={loc.schedule}
            phone={loc.phone}
            mapsUrl={loc.mapsUrl}
            imageUrl={loc.imageUrl}
            whatsappPhone={loc.whatsappPhone}
            theme="light"
          />
          <MapEmbed
            src={loc.mapsEmbedSrc}
            title={`Localização — ${loc.name}`}
          />
        </div>
      ))}

    </div>
  </section>

  <!-- Canais de contato -->
  <section class="section bg-primary-light" aria-label="Canais de agendamento">
    <div class="container flex flex-col gap-8 max-w-2xl">

      <div class="flex flex-col gap-2">
        <h2 class="font-display text-display-md text-cream heading-display">
          Fale com a secretária
        </h2>
        <p class="text-cream-muted text-base">
          Um número centraliza os dois locais. Ela informa disponibilidade e confirma o agendamento.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4">
        <WhatsAppButton
          phone="5534992206100"
          message="Olá! Gostaria de informações sobre consulta com o Dr. Celso Pintinha."
          variant="large"
          label="WhatsApp da Secretária"
        />
      </div>

      <div class="flex flex-col gap-3 pt-4 border-t border-border">
        <div class="flex flex-col gap-1">
          <p class="text-xs font-semibold text-accent uppercase tracking-widest">Outras formas</p>
          <p class="text-sm text-cream-muted">
            <strong class="font-medium text-cream">Doctoralia:</strong>{' '}
            <CTAButton
              href="https://www.doctoralia.com.br/celso-pintinha/ortopedista-traumatologista/uberaba#address-id=1381834&is-online-only=false&filters%5Bspecializations%5D%5B%5D=67"
              label="Agendar online"
              variant="ghost"
              external={true}
              class="inline-flex px-0 py-0 text-sm underline underline-offset-2"
            />
          </p>
          <p class="text-sm text-cream-muted">
            <strong class="font-medium text-cream">E-mail:</strong>{' '}
            [PENDENTE — e-mail de contato]
          </p>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
